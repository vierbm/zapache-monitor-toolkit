#!/usr/bin/env bash

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

source "$BASE_DIR/lib/common.sh"
source "$BASE_DIR/lib/apache.sh"
source "$BASE_DIR/lib/parser.sh"
source "$BASE_DIR/lib/metrics.sh"
source "$BASE_DIR/lib/scoreboard.sh"
source "$BASE_DIR/lib/zabbix.sh"

parser_set_logfile "/var/log/httpd/internet-access.log"

zabbix_run "$1"
