#!/usr/bin/env bash
#
# Name: zabbix_apache
# Description: Zabbix Apache mod_status monitoring script
# Version: 1.5

LOGFILE="/var/log/httpd/internet-access.log"
VERSION="1.5"

usage() {
cat <<EOF
Usage: $0 <Metric> [server-status URL]

Examples:
  $0 BusyWorkers
  $0 ReqPerSec
  $0 Http40xErrCount
  $0 BusyWorkers http://127.0.0.1/server-status?auto

Available Metrics:

  TotalAccesses
  TotalKBytes
  CPULoad
  Uptime
  ReqPerSec
  BytesPerSec
  BytesPerReq
  BusyWorkers
  IdleWorkers
  ConnsTotal
  ConnsAsyncWriting
  ConnsAsyncKeepAlive
  ConnsAsyncClosing

  WaitingForConnection
  StartingUp
  ReadingRequest
  SendingReply
  KeepAlive
  DNSLookup
  ClosingConnection
  Logging
  GracefullyFinishing
  IdleCleanupOfWorker
  OpenSlotWithNoCurrentProcess

  Http40xErrCount
  Http50xErrCount

  version
EOF
}

[[ $# -lt 1 ]] && {
    usage
    exit 1
}

METRIC="$1"
URL="${2:-http://127.0.0.1/server-status?auto}"

###############################################################################
# Fetch Apache server-status
###############################################################################
fetch_status() {

    if command -v curl >/dev/null 2>&1; then
        no_proxy="127.0.0.1,localhost" \
        curl -fsS --max-time 5 "$URL"
    else
        no_proxy="127.0.0.1,localhost" \
        wget --quiet \
             --tries=1 \
             --timeout=5 \
             -O - \
             "$URL"
    fi
}

###############################################################################
# Return numeric metric
###############################################################################
metric() {

    awk -F': ' -v key="$1" '

        $1 == key {
            print $2
            found=1
            exit
        }

        END {
            if (!found)
                print 0
        }

    ' <<< "$VAR"
}

###############################################################################
# Count scoreboard characters
###############################################################################
count_char() {

    local char="$1"

    local scoreboard

    scoreboard=$(awk -F': ' '/^Scoreboard:/ {print $2}' <<< "$VAR")

    [[ -z "$scoreboard" ]] && {
        echo 0
        return
    }

    printf "%s" "$scoreboard" |
        tr -cd "$char" |
        wc -c
}

###############################################################################
# Fetch mod_status only when needed
###############################################################################
case "$METRIC" in
    Http40xErrCount|Http50xErrCount|version)
        ;;
    *)
        VAR=$(fetch_status)

        if [[ $? -ne 0 || -z "$VAR" ]]; then
            echo "ZBX_NOTSUPPORTED"
            exit 1
        fi

        if ! grep -q '^BusyWorkers:' <<< "$VAR"; then
            echo "ZBX_NOTSUPPORTED"
            exit 1
        fi
        ;;
esac

###############################################################################
# Main
###############################################################################
case "$METRIC" in

###############################################################################
# Log metrics
###############################################################################

Http40xErrCount)

    if [[ -f "$LOGFILE" ]]; then

        TIME_PATTERN=$(date --date='1 minute ago' +'%d/%b/%Y:%H:%M')

        tail -n 10000 "$LOGFILE" |
        awk -v t="$TIME_PATTERN" '
            index($0,t) && $9 ~ /^4[0-9][0-9]$/ {c++}
            END {print c+0}
        '
    else
        echo 0
    fi

    ;;

Http50xErrCount)

    if [[ -f "$LOGFILE" ]]; then

        TIME_PATTERN=$(date --date='1 minute ago' +'%d/%b/%Y:%H:%M')

        tail -n 10000 "$LOGFILE" |
        awk -v t="$TIME_PATTERN" '
            index($0,t) && $9 ~ /^5[0-9][0-9]$/ {c++}
            END {print c+0}
        '

    else
        echo 0
    fi

    ;;

###############################################################################
# Apache metrics
###############################################################################

TotalAccesses)          metric "Total Accesses" ;;
TotalKBytes)            metric "Total kBytes" ;;
CPULoad)                metric "CPULoad" ;;
Uptime)                 metric "Uptime" ;;
ReqPerSec)              metric "ReqPerSec" ;;
BytesPerSec)            metric "BytesPerSec" ;;
BytesPerReq)            metric "BytesPerReq" ;;
BusyWorkers)            metric "BusyWorkers" ;;
IdleWorkers)            metric "IdleWorkers" ;;
ConnsTotal)             metric "ConnsTotal" ;;
ConnsAsyncWriting)      metric "ConnsAsyncWriting" ;;
ConnsAsyncKeepAlive)    metric "ConnsAsyncKeepAlive" ;;
ConnsAsyncClosing)      metric "ConnsAsyncClosing" ;;

###############################################################################
# Scoreboard
###############################################################################

WaitingForConnection)           count_char "_" ;;
StartingUp)                     count_char "S" ;;
ReadingRequest)                 count_char "R" ;;
SendingReply)                   count_char "W" ;;
KeepAlive)                      count_char "K" ;;
DNSLookup)                      count_char "D" ;;
ClosingConnection)              count_char "C" ;;
Logging)                        count_char "L" ;;
GracefullyFinishing)            count_char "G" ;;
IdleCleanupOfWorker)            count_char "I" ;;
OpenSlotWithNoCurrentProcess)   count_char "." ;;

###############################################################################

version)

    echo "$VERSION"

    ;;

*)

    usage
    exit 1

    ;;

esac

exit 0
